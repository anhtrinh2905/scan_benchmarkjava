CUSTOM_SCAN_MODEL=glm-5.1
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_API_KEY=

# LangSmith — tuỳ chọn. Ghi log mọi lượt gọi LLM (`llm_trace.py`) lên LangSmith.
# Không có key thì tầng này tắt hẳn và im lặng. Khi repo này là submodule của
# ai-security-copilot thì không cần đặt lại ở đây: key ở `.env` của repo cha cũng
# được đọc. Đặt LANGSMITH_TRACING=0 để tắt tạm mà vẫn giữ key.
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=ai-security-copilot
