# Model Metis dùng để QUÉT (OpenAI-compatible model id).
# Không có LLM-judge — chỉ biến này điều khiển model.
# OpenCode Go: deepseek-v4-flash | deepseek-v4-pro | glm-5.1 | kimi-k2.6 | ...
# Danh sách: https://opencode.ai/zen/go/v1/models
CUSTOM_SCAN_MODEL=deepseek-v4-flash

# OpenCode Go (subscription) — OpenAI-compatible base URL.
# Lấy API key sau khi subscribe: https://opencode.ai/auth
# Nếu dùng Zen pay-as-you-go thay vì Go: https://opencode.ai/zen/v1
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_API_KEY=
